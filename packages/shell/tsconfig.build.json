{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "declarationMap": true,
    "outDir": "./dist/esm",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "./src",
    "sourceMap": true,
    // Without this the build info lands in ./dist and ships in the published tarball.
    "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.spec.ts", "src/mocks/**/*"],
  // Under the `source` condition core resolves to its `src/`; the reference makes the
  // build read core's emitted declarations for it instead of compiling it into this
  // package's output.
  "references": [{ "path": "../core/tsconfig.build.json" }]
}
