{
  "name": "@limulus/lemmon-shell",
  "version": "0.0.0",
  "description": "Lemmon shell: CLI, content walker, plugin host, and dev server",
  "keywords": [
    "lemmon",
    "static-site-generator",
    "cli"
  ],
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "imports": {
    "#cli": {
      "source": "./src/lib/cli.ts",
      "default": "./dist/esm/lib/cli.js"
    }
  },
  "bin": {
    "lem": "bin/lem.js"
  },
  "files": [
    "ambient.lem",
    "bin",
    "dist",
    "src",
    "!src/**/*.spec.ts",
    "!src/mocks"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limulus/lemmon.git",
    "directory": "packages/shell"
  },
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@limulus.net",
    "url": "https://limulus.net/"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/limulus/lemmon/issues"
  },
  "homepage": "https://github.com/limulus/lemmon/tree/main/packages/shell#readme",
  "dependencies": {
    "@csstools/css-tokenizer": "^4.0.2",
    "@limulus/lemmon-core": "0.0.0",
    "@prettier/parse-srcset": "^3.1.0",
    "@xmldom/xmldom": "^0.9.12",
    "chokidar": "^5.0.0",
    "esbuild": "0.24.0",
    "esbuild-plugin-wasm": "1.1.0",
    "highlight.js": "11.9.0",
    "mime-types": "^3.0.2",
    "parse5": "^8.1.0",
    "picomatch": "^4.0.7",
    "tslib": "^2.8.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
