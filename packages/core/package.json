{
  "name": "@limulus/lemmon-core",
  "version": "0.0.0",
  "description": "Lemmon core: typed wrapper around the Rust/WASM compiler and VM",
  "keywords": [
    "lemmon",
    "template-language",
    "webassembly"
  ],
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "artifacts",
    "dist",
    "src",
    "!src/**/*.spec.ts"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limulus/lemmon.git",
    "directory": "packages/core"
  },
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@limulus.net",
    "url": "https://limulus.net/"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/limulus/lemmon/issues"
  },
  "homepage": "https://github.com/limulus/lemmon/tree/main/packages/core#readme",
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
