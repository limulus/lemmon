{
  "name": "lemmon",
  "version": "0.0.0",
  "private": true,
  "description": "A static site generator and typed, tag-based template language",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "npm run clean:js",
    "build": "node node_modules/typescript-7/bin/tsc --build tsconfig.build.json",
    "clean": "npm run clean:js && del-cli target artifacts",
    "clean:js": "del-cli \"*.tsbuildinfo\" \"packages/*/*.tsbuildinfo\" coverage \"packages/*/dist\"",
    "corpus:bless": "UPDATE_CORPUS=1 cargo test --workspace",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "prepare": "is-ci || husky",
    "rust": "cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "rust:cov": "cargo llvm-cov --workspace --fail-under-lines 97",
    "rust:wasm": "cargo build --release -p lemmon-wasm --target wasm32-unknown-unknown && node scripts/stage-wasm.ts",
    "rust:wasm:test": "CARGO_TARGET_WASM32_UNKNOWN_UNKNOWN_RUNNER=wasm-bindgen-test-runner cargo test -p lemmon-wasm --target wasm32-unknown-unknown --test boundary",
    "test": "vitest run --coverage",
    "test:fidelity": "node scripts/render-the-rebound.ts",
    "test:fixtures": "node scripts/bench-wasm.ts",
    "tscc": "node node_modules/typescript-7/bin/tsc --build tsconfig.json packages/*/tsconfig.json",
    "verify": "concurrently -c cyan,magenta,blue,yellow npm:verify:js npm:rust",
    "verify:js": "(is-ci || npm run rust:wasm) && concurrently -c cyan,magenta,blue,green,yellow npm:lint npm:test npm:tscc npm:test:fidelity npm:test:fixtures",
    "wasm:bench": "node scripts/bench-wasm.ts --time",
    "wasm:check": "node scripts/check-wasm.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/limulus/lemmon.git"
  },
  "author": {
    "name": "Eric McCarthy",
    "email": "eric@limulus.net",
    "url": "https://limulus.net/"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/limulus/lemmon/issues"
  },
  "homepage": "https://github.com/limulus/lemmon#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@limulus/eslint-config": "^6.2.0",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.5",
    "del-cli": "^7.0.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
