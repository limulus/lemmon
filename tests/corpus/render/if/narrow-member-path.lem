<lem-type Photo>
  url: string
  caption: string?
</lem-type>
<lem-type Article>
  title: string
  hero: Photo?
</lem-type>
<lem-fn card(article: Article): string = article.hero ? article.hero.url : "no hero" />
<lem-let a: Article = {title: "T", hero: {url: "/h.jpg", caption: "A caption"}} />
<lem-let b: Article = {title: "U"} />
<lem-if a.hero>
  narrowed: <lem.a.hero.url>
  <lem-if a.hero.caption>two deep: <lem.a.hero.caption></lem-if>
  <lem-if (a.hero)>still accepted as a condition: <lem.a.hero.url></lem-if>
  a dead default is not a mistake: <lem.a.hero.caption ?? "none">
  <lem-let f = |suffix| a.hero.url + suffix />
  read inside a lambda: <lem.f("!")>
<lem-else />
  not narrowed in the else: <lem.a.hero?.url ?? "none">
</lem-if>
in a ternary: <lem.card(a)> <lem.card(b)>
<lem-if b.hero>never<lem-else />b has no hero</lem-if>
<lem-if a.hero>
  <lem-let a: Article = b />
  an inner binding ends it: <lem.a.hero?.url ?? "the inner a has no hero">
</lem-if>
