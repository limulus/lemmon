<lem-fn double(x: int): int = x * 2 />
<lem-fn describe(article: any, suffix: string): string = article.title + suffix />
<lem-fn isDraft(article: any): bool = article.draft ?? false />
<lem-let article = {title: "The Rebound", draft: null} />
<lem.double(21)>
<lem.describe(article, suffix: "!")>
<lem.article.describe(" (UFCS)")>
<lem.21.double().double()>
<lem.article.isDraft() ? "draft" : "published">
