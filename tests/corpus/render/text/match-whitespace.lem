<lem-enum Placement = hero | left />
<lem-fn photo(p: Placement)>
  <lem-let figure>
    <figure>
      <lem-match p>
        <lem-case .hero>
          <img class="hero">
        </lem-case>

        <lem-case .left>
          <img class="left">
        </lem-case>
      </lem-match>
    </figure>
  </lem-let>
  <div><lem.figure></div>
</lem-fn>
<lem.photo(.hero)>
<lem.photo(.left)>
