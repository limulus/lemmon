<lem-fn card(raw: string)>
  <h1><lem.raw></h1>
</lem-fn>
<lem-let raw = "shadowed" />
<lem-for raw, i in ["loop"]><lem.card(raw)><lem.i></lem-for>
<lem-let cooked = |raw| raw />
<lem.cooked(raw)>
<lem-fn url(path: string): string = "/blog/" + path />
<lem-let datetime = "a name an author may well reach for" />
<lem-let urls = ["/a/"] />
<lem-fn asset(path: string): string = "/static/" + path />
<lem-let uniqueId = "and one an author would not, but the warning is the same" />
<lem.url("a")><lem.datetime><lem.urls[0]><lem.asset("x")><lem.uniqueId>
