<lem-fn double(x: int): int = x * 2 />
<lem-fn greet(who: string, loudly: bool): string = loudly ? who + "!" : who />
<lem-fn apply(f: (int): int, x: int): int = f(x) />
<lem-fn chip(label: string, count: int?)>
  <span><lem.label><lem-if count> (<lem.count>)</lem-if></span>
</lem-fn>
<lem.double(21)> <lem.greet("you", loudly: true)> <lem.greet(loudly: false, who: "you")>
<lem.apply(|v| v + 1, 1)> <lem.apply(double, 4)>
<lem-let inc: (int): int = |v| v + 1 />
<lem-let untyped = |a, b| a == b ? b : a />
<lem-let plusOne = double />
<lem-let triple: (int): int = |v| v * 3 />
<lem.inc(2)> <lem.untyped(1, "b")> <lem.plusOne(5)> <lem.triple(2)>
<lem.chip("tag", 3)><lem.chip("bare", null)>
<lem.double(3)> <lem.greet("you", loudly: false)>
<lem-let p: any = page />
<lem.greet(p.title, false)>
<lem.raw("<i>x</i>")> <lem.raw(raw("<i>y</i>"))> <lem.raw(p.title)>
