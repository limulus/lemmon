<lem-let heading = "Hi There" />
<lem-let words = [1, 2] />
<lem-let n = 3 />
<lem-let maybe: string? = null />
<lem-let nothing = null />
<lem-let m = {a: "x"} />
<lem-type Post>
  title: string
</lem-type>
<lem-fn slugify(s: string): string = s + "!" />
<lem.heading.slugify>
<lem.heading.slugfy> <lem.words.lenght> <lem.heading.byline>
<lem.heading.slugify(1)> <lem.words.first(1) ?? 0>
<lem.heading.nope()> <lem.n.nope()> <lem.m.foo()>
<lem.heading?.slugify()> <lem.maybe.slugify()>
<lem.nothing.f> <lem.nothing.f()>
<lem.heading.slugify(x: 1)> <lem.m.get(k: "a")>
<lem-fn show(p: Post): string = p.slugify() />
