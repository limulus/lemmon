<lem-enum Size = small | large />
<lem-type Box>
  size: Size
</lem-type>
<lem-fn show(size: Size): string = size == .small ? "s" : "l" />
<lem-let s: Size = .smal />
<lem.show(.medium)> <lem.show(small)> <lem.show(Size.smal)>
<lem..small> <lem.Size> <lem.Box> <lem.Box.size> <lem.Size?.small>
<lem.Size(1)> <lem.Box(1)>
<lem.show("small")> <lem.s == null ? "-" : "+">
<lem-if s == "small">text</lem-if>
<lem-let both = s == .large || s in ["large"] />
<lem.both ? "y" : "n">
<lem-let word = "small" />
<lem.show(word)> <lem.show(s)>
<lem.Size.small.length> <lem.Size.large()>
<lem.(.small.length)> <lem.(.small ?? "x")>
<lem-let xs = [.small, Size.large] />
<lem.xs[0]>
