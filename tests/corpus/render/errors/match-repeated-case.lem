<lem-enum Placement = hero | left />
<lem-type Article>
  title: string
</lem-type>
<lem-type LinkPost extends Article>
  link: string
</lem-type>
<lem-let p: Placement = .hero />
<lem-let a: Article = {title: "T"} />
<lem-match p>
  <lem-case .hero>hero</lem-case>
  <lem-case .hero>again</lem-case>
  <lem-case .left>left</lem-case>
</lem-match>
<lem-match a>
  <lem-case LinkPost as l><lem.l.link></lem-case>
  <lem-case LinkPost>again</lem-case>
  <lem-default>other</lem-default>
</lem-match>
<lem-match a.title>
  <lem-case "T">t</lem-case>
  <lem-case "T">again</lem-case>
  <lem-case "\T">the same string, spelled with an escape</lem-case>
  <lem-case "U">u</lem-case>
  <lem-default>other</lem-default>
</lem-match>
