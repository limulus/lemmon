<lem-type Photo>
  url: url
  alt: string
</lem-type>
<lem-type Vod>
  poster: url
  alt: string
</lem-type>
<lem-type Article>
  title: string
  url: url
  author: string
  date: string
  image: Photo?
  hero: Photo?
  vod: Vod?
  subhead: string?
  teaser: string?
</lem-type>
<lem-fn picture(photo: Photo, sizes: [string], class: string)>
  <img src="<lem.photo.url>" alt="<lem.photo.alt>" class="<lem.class>" sizes="<lem.sizes[0]>">
</lem-fn>
<lem-fn authorChip(article: Article, nolink: bool)>
  <lem-if nolink><span><lem.article.author></span><lem-else /><a href="/<lem.article.author>/"><lem.article.author></a></lem-if>
</lem-fn>
<lem-fn publishedChip(article: Article)>
  <time><lem.article.date></time>
</lem-fn>
<lem-fn chipList(size: string, slot: html)>
  <ul class="chip-list <lem.size>">
    <lem.slot>
  </ul>
</lem-fn>
<lem-fn articleCard(article: Article)>
  <article class="article-card">
    <a href="<lem.article.url>">
      <lem-let preview = article.image ?? article.hero />
      <lem-if preview>
        <lem.picture(preview, ["md"], class: "preview")>
      <lem-else-if article.vod />
        <img src="<lem.article.vod.poster>" alt="<lem.article.vod.alt>" class="preview">
      </lem-if>
      <div class="text-content">
        <header>
          <h1><lem.article.title></h1>
          <lem-let chips>
            <li><lem.authorChip(article, nolink: true)></li>
            <li><lem.publishedChip(article)></li>
          </lem-let>
          <lem.chipList(size: "small", slot: chips)>
        </header>
        <p><lem.(article.subhead ?? article.teaser ?? "")></p>
      </div>
    </a>
  </article>
</lem-fn>
<lem-let hero = {url: "/photos/upper-falls.jpg", alt: "Upper Falls, Letchworth State Park"} />
<lem-let articles: any = [
  {title: "The Rebound", url: "/feed/the-rebound/", author: "eric", date: "2024-11-24", image: null, hero: hero, vod: null, subhead: "I’m rebuilding limulus.net.", teaser: null},
  {title: "A Video", url: "/feed/a-video/", author: "eric", date: "2025-01-01", image: null, hero: null, vod: {poster: "/vod/poster.jpg", alt: "Still"}, subhead: null, teaser: "Watch & learn"},
] />
<lem-for article in articles>
<lem.articleCard(article)>
</lem-for>
