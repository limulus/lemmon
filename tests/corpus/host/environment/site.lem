<lem-enum Placement = hero | left | right />

<lem-type Photo>
  caption: string
  placement: Placement
</lem-type>

<lem-type Article extends Page>
  title: string
  subhead: string?
  date: datetime = datetime("2026-01-01")
  runtime: duration?
  hero: Photo? by site.photos
  layout: (Article, html): html = article
</lem-type>

<lem-type Til extends Page>
  topic: string
  heading: string = tilHeading(self)
  title: string = "TIL: " + self.topic
  slug: string = path
  excerpt: html = body
  readingTime: duration = body.readingTime()
  hero: Photo? by site.photos
  layout: (Til, html): html = til
</lem-type>

<lem-fn article(a: Article, body: html)>
  <h1><lem.a.title></h1>
  <lem.body>
</lem-fn>

<lem-fn til(t: Til, body: html)>
  <h1><lem.t.title></h1>
  <lem.body>
</lem-fn>

<lem-fn tilHeading(t: Til): string = "# " + t.title />

<lem-let photos: {string: Photo} from "_data/photos.json" />
<lem-let posts: [Article] from "pages/*.md" />
<lem-let tils: [Til] from "tils/*.md" />
<lem-let siteUrl: url from env("SITE_URL") />
<lem-let name: string = "limulus.net" />
<lem-let tagline: string = "Notes from " + name />
