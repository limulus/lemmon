<lem-enum Placement = hero | left | right />

<lem-type Photo>
  caption: string
  placement: Placement
</lem-type>

<lem-type Article extends Page>
  title: string
  subhead: string?
  date: datetime = datetime("2026-01-01")
  runtime: duration?
  scripts: [asset] = []
  hero: Photo? by site.photos
  layout: (Article, html): html = article
</lem-type>

<lem-type Til extends Page>
  topic: string
  heading: string = tilHeading(self)
  title: string = "TIL: " + self.topic
  slug: string = path
  excerpt: html = body
  readingTime: duration = body.readingTime()
  hero: Photo? by site.photos
  layout: (Til, html): html = til
</lem-type>

<lem-type SitePage extends Page>
  title: string
  teaser: string?
  layout: (SitePage, html): html = sitePage
</lem-type>

<lem-type TilTopicPage extends SitePage>
  topic: string
  title: string = "TILs: " + self.topic
  url: url = url("/tils/" + self.topic + "/")
</lem-type>

<lem-type PhotoPage extends Page>
  photo: Photo
  title: string = self.photo.caption
  url: url = url("/photos/" + self.photo.caption.slugify() + "/")
  prev: PhotoPage?
  next: PhotoPage?
  layout: (PhotoPage, html): html = photoPage
</lem-type>

<lem-fn article(a: Article, body: html)>
  <h1><lem.a.title></h1>
  <lem.body>
</lem-fn>

<lem-fn til(t: Til, body: html)>
  <h1><lem.t.title></h1>
  <lem.body>
</lem-fn>

<lem-fn sitePage(p: SitePage, body: html)>
  <h1><lem.p.title></h1>
  <lem.body>
</lem-fn>

<lem-fn photoPage(p: PhotoPage, body: html)>
  <h1><lem.p.title></h1>
  <lem.body>
</lem-fn>

<lem-fn tilHeading(t: Til): string = "# " + t.title />

<lem-let photos: {string: Photo} from "_data/photos.json" />
<lem-let gallery: [Photo] = photos.values() />
<lem-let posts: [Article] from "pages/*.md" />
<lem-let tils: [Til] from "tils/*.md" />
<lem-let sections: [SitePage] from "sections/*.lem" />
<lem-let siteUrl: url from env("SITE_URL") />
<lem-let topics: [string] = ["git", "nodejs", "rust"] />
<lem-let draftTopics: [string] = [] />
<lem-let name: string = "limulus.net" />
<lem-let tagline: string = "Notes from " + name />
