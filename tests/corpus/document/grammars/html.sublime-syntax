%YAML 1.2
---
# A corpus fixture, not an HTML grammar: tags, entities, and a `<style>` element that
# embeds the CSS fixture by scope (tests/corpus/README.md).
name: HTML
file_extensions: [html, htm]
scope: text.html
contexts:
  main:
    - match: '<!--'
      push: comment
    - match: '(<)(style)(>)'
      captures:
        1: punctuation.definition.tag.begin
        2: entity.name.tag
        3: punctuation.definition.tag.end
      embed: scope:source.css
      escape: '(?=</style>)'
    - match: '</?[A-Za-z][A-Za-z0-9.-]*'
      scope: entity.name.tag
    - match: '&[a-z]+;'
      scope: constant.character.entity
  comment:
    - meta_scope: comment.block
    - match: '-->'
      pop: true
